{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react",
    "lib": ["DOM"],
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["jest", "node"]
  },
  "include": [
